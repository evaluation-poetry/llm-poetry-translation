# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MAX_TOKENS=8192

# Baidu Translate
BAIDU_TRANSLATE_APP_ID=
BAIDU_TRANSLATE_SECRET_KEY=

# Qwen / Alibaba Cloud Model Studio (DashScope OpenAI-compatible API)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-plus
QWEN_MAX_TOKENS=8192
QWEN_THINKING_BUDGET=

# Claude Messages-compatible endpoint.
# Set both key and base URL for each endpoint you use.
CLAUDE_TRANSIT_API_KEY=
CLAUDE_TRANSIT_BASE_URL=
CLAUDE_TRANSIT_API_KEYS=
CLAUDE_TRANSIT_BASE_URLS=
CLAUDE_TRANSIT_PRIMARY_API_KEY=
CLAUDE_TRANSIT_PRIMARY_BASE_URL=
CLAUDE_TRANSIT_SECONDARY_API_KEY=
CLAUDE_TRANSIT_SECONDARY_BASE_URL=

# LLM-as-judge
JUDGE_DEEPSEEK_API_KEY=
JUDGE_DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
JUDGE_DEEPSEEK_MODEL=deepseek-v4-pro
JUDGE_RESPONSE_FORMAT_JSON=1

# Metrics
COMET_MODEL=Unbabel/wmt22-comet-da
BERTSCORE_MODEL=microsoft/deberta-xlarge-mnli
